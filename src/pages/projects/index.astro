---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectFilters from '../../components/ProjectFilters.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Proyectos | Luis Pichio">
  <div class="page-shell">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h1>Proyectos</h1>
        <p class="prose">Una selección de desarrollos de hardware, firmware, software industrial, instrumentación, IoT y herramientas técnicas.</p>
      </div>
      <a class="button back-home" href="/">Inicio</a>
    </div>
    <ProjectFilters projects={projects} />
  </div>
</BaseLayout>
