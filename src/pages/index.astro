---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCloud from '../components/SkillCloud.astro';
import { profile, jobs } from '../data/profile';
import { keySkills } from '../data/skills';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((project) => project.data.featured)
  .slice(0, 6);
---

<BaseLayout title="Luis Pichio | Portfolio IoT, firmware y hardware">
  <section class="hero">
    <div>
      <p class="eyebrow">{profile.role} | {profile.location}</p>
      <h1>{profile.intro}</h1>
      <p>{profile.summary}</p>
      <div class="actions">
        <a class="button primary" href={profile.resume}>Descargar CV</a>
        <a class="button" href="/projects/">Ver proyectos</a>
        <a class="button" href={`mailto:${profile.email}`}>Contactar</a>
      </div>
    </div>
    <div class="portrait"><img src={profile.image} alt="Foto de Luis Pichio" /></div>
  </section>

  <section>
    <div class="section-title"><h2>Lo que conecto</h2><p class="eyebrow">De la placa al cloud</p></div>
    <div class="focus-grid">
      {profile.focusAreas.map((item) => <div class="focus-card"><h3>{item.title}</h3><p>{item.summary}</p></div>)}
    </div>
  </section>

  <section id="experiencia">
    <div class="section-title"><h2>Experiencia</h2><a class="button" href="/cv/">CV completo</a></div>
    {jobs.map((job) => (
      <article class="job">
        <p class="eyebrow">{job.period} | {job.place}</p>
        <h3>{job.role}</h3>
        <p><a href={job.url}>{job.company}</a>{job.detail ? ` - ${job.detail}` : ''}</p>
        <ul>{job.tasks.map((task) => <li>{task}</li>)}</ul>
      </article>
    ))}
  </section>

  <section id="skills">
    <div class="section-title"><h2>Skills</h2></div>
    <div class="grid">
      {keySkills.map((skill) => (
        <div class="card"><h3>{skill.name}</h3><p>{skill.experience} | {skill.level}</p></div>
      ))}
    </div>
    <SkillCloud />
  </section>

  <section>
    <div class="section-title"><h2>Proyectos destacados</h2><a class="button" href="/projects/">Todos los proyectos</a></div>
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
