---
import '../styles/global.css';
import { profile } from '../data/profile';

const { title = profile.name, description = profile.summary } = Astro.props;
const year = new Date().getFullYear();
const isExternal = (href: string) => href.startsWith('http');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header id="top" class="site-header">
      <a class="brand" href="/">Luis Pichio</a>
      <nav aria-label="Principal">
        <a href="/#experiencia">Experiencia</a>
        <a href="/#skills">Skills</a>
        <a href="/projects/">Proyectos</a>
        <a href="/cv/">CV</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-links">
        {profile.socials.map((social) => (
          <a href={social.href} target={isExternal(social.href) ? '_blank' : undefined} rel={isExternal(social.href) ? 'noreferrer' : undefined}>
            {social.label}
          </a>
        ))}
      </div>
      <p>© {year} Luis Pichio · <a href="https://github.com/luispichio/luispichio.github.io" target="_blank" rel="noreferrer">Proyecto en GitHub</a></p>
    </footer>
  </body>
</html>
