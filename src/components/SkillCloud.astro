---
import { technicalSkills } from '../data/skills';

const sortedSkills = [...technicalSkills].sort((a, b) => a.name.localeCompare(b.name, 'es'));

function experienceWeight(experience: string) {
  const value = Number(experience.match(/\d+/)?.[0] ?? 1);
  if (value >= 20) return 5;
  if (value >= 15) return 4;
  if (value >= 10) return 3;
  if (value >= 5) return 2;
  return 1;
}
---

<div class="skill-map" data-skill-map>
  <div class="skill-map-help" data-skill-help hidden>
    <strong>Cómo explorar</strong>
    <span>Click en categoría o sub-categoría para filtrar.</span>
    <span>Hover sobre una skill para ver stats.</span>
    <span>Arrastrá para mover. Usá + / - para zoom.</span>
    <span>Clic derecho para volver al filtro anterior.</span>
  </div>
  <div class="skill-map-controls" aria-label="Controles del mapa de skills">
    <button class="filter-button map-control icon-control" type="button" data-skill-back-filter title="Volver al filtro anterior" aria-label="Volver al filtro anterior" disabled>&lt;</button>
    <button class="filter-button map-control icon-control" type="button" data-skill-zoom-out title="Alejar" aria-label="Alejar">-</button>
    <button class="filter-button map-control icon-control" type="button" data-skill-zoom-in title="Acercar" aria-label="Acercar">+</button>
    <button class="filter-button map-control" type="button" data-skill-reset-view>Reset vista</button>
    <button class="filter-button map-control icon-control" type="button" data-skill-toggle-help title="Cómo explorar" aria-label="Cómo explorar">?</button>
  </div>
  <label class="skill-map-search" aria-label="Buscar en el mapa de skills">
    <span>Buscar</span>
    <input type="search" placeholder="Skill, grupo o categoría" autocomplete="off" spellcheck="false" data-skill-text-filter />
    <button type="button" title="Limpiar búsqueda" aria-label="Limpiar búsqueda" data-skill-clear-text hidden>×</button>
  </label>
  <div class="skill-map-filter-strip" aria-label="Filtros de experiencia y nivel">
    <small data-skill-filter-summary>Filtro: todos</small>
    <label class="range-control">
      <span>Experiencia mínima: <strong data-skill-experience-value>0 años</strong></span>
      <input type="range" min="0" max="8" value="0" step="1" data-skill-experience-filter />
    </label>
  </div>
  <svg class="skill-map-svg" data-skill-map-svg role="img" aria-label="Mapa radial de skills por categoría y sub-categoría">
    <g data-skill-map-viewport>
      <g data-skill-map-links></g>
      <g data-skill-map-nodes></g>
    </g>
  </svg>
  <div class="skill-map-tooltip" data-skill-tooltip hidden></div>
</div>

<script type="application/json" data-skill-data set:html={JSON.stringify(sortedSkills.map((skill) => ({ ...skill, weight: experienceWeight(skill.experience) })))} />

<script>
  const skillMap = document.querySelector<HTMLElement>('[data-skill-map]');
  const skillData = document.querySelector<HTMLScriptElement>('[data-skill-data]');

  if (skillMap && skillData) {
    type Skill = { category: string; group: string; name: string; experience: string; level: string; weight: number; years: number };
    type FilterState = { category: string; group: string; minExperience: number; query: string };
    type MapNode = { id: string; parent?: string; type: string; label: string; category?: string; group?: string; experience?: string; level?: string; weight?: number; angle: number; radius: number; offsetX: number; offsetY: number; x: number; y: number; baseX: number; baseY: number; width?: number; height?: number; element?: SVGGElement };

    const svg = skillMap.querySelector<SVGSVGElement>('[data-skill-map-svg]');
    const viewport = skillMap.querySelector<SVGGElement>('[data-skill-map-viewport]');
    const linkLayer = skillMap.querySelector<SVGGElement>('[data-skill-map-links]');
    const nodeLayer = skillMap.querySelector<SVGGElement>('[data-skill-map-nodes]');
    const resetViewButton = skillMap.querySelector<HTMLButtonElement>('[data-skill-reset-view]');
    const backFilterButton = skillMap.querySelector<HTMLButtonElement>('[data-skill-back-filter]');
    const zoomInButton = skillMap.querySelector<HTMLButtonElement>('[data-skill-zoom-in]');
    const zoomOutButton = skillMap.querySelector<HTMLButtonElement>('[data-skill-zoom-out]');
    const toggleHelpButton = skillMap.querySelector<HTMLButtonElement>('[data-skill-toggle-help]');
    const helpPanel = skillMap.querySelector<HTMLElement>('[data-skill-help]');
    const textFilter = skillMap.querySelector<HTMLInputElement>('[data-skill-text-filter]');
    const clearTextButton = skillMap.querySelector<HTMLButtonElement>('[data-skill-clear-text]');
    const experienceFilter = skillMap.querySelector<HTMLInputElement>('[data-skill-experience-filter]');
    const experienceValue = skillMap.querySelector<HTMLElement>('[data-skill-experience-value]');
    const filterSummary = skillMap.querySelector<HTMLElement>('[data-skill-filter-summary]');
    const tooltip = skillMap.querySelector<HTMLElement>('[data-skill-tooltip]');
    const rawSkills = JSON.parse(skillData.textContent || '[]') as Array<Omit<Skill, 'years'>>;
    const experienceSteps = [0, 1, 2, 3, 5, 10, 15, 20, 25];
    const skills = rawSkills.map((skill) => ({ ...skill, years: experienceYears(skill.experience) }));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ns = 'http://www.w3.org/2000/svg';
    const nodes: MapNode[] = [];
    const links: Array<{ source: string; target: string; element?: SVGPathElement }> = [];
    let animationId = 0;
    let panX = 0;
    let panY = 0;
    let zoom = 1;
    let isPanning = false;
    let lastPointerX = 0;
    let lastPointerY = 0;
    let time = 0;
    let rotation = 0;
    let activeCategory = 'todos';
    let activeGroup = 'todos';
    let minExperience = 0;
    let textQuery = '';
    let filterHistory: FilterState[] = [];
    let sliderHistoryArmed = false;
    let textHistoryArmed = false;
    let ellipseScaleX = 1;
    let ellipseScaleY = 1;

    function experienceYears(experience: string) {
      if (experience.includes('<')) return 0;
      return Number(experience.match(/\d+/)?.[0] ?? 0);
    }

    function normalizeText(value: string) {
      return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    }

    function updateResetFilterButton() {
      if (!backFilterButton) return;
      backFilterButton.disabled = filterHistory.length === 0;
    }

    function updateFilterSummary() {
      if (!filterSummary) return;
      const parts = [];
      if (activeCategory !== 'todos') parts.push(activeCategory);
      if (activeGroup !== 'todos') parts.push(activeGroup);
      if (minExperience > 0) parts.push(`+${minExperience} años`);
      if (textQuery) parts.push(`"${textQuery}"`);
      filterSummary.textContent = `Filtro: ${parts.length > 0 ? parts.join(' / ') : 'todos'}`;
    }

    function updateFilterUi() {
      if (experienceFilter) experienceFilter.value = `${experienceSteps.indexOf(minExperience)}`;
      if (experienceValue) experienceValue.textContent = minExperience === 0 ? '0 años' : `+${minExperience} años`;
      if (textFilter && textFilter.value !== textQuery) textFilter.value = textQuery;
      if (clearTextButton) clearTextButton.hidden = textQuery.length === 0;
      updateResetFilterButton();
      updateFilterSummary();
    }

    function currentFilterState(): FilterState {
      return { category: activeCategory, group: activeGroup, minExperience, query: textQuery };
    }

    function sameFilterState(a: FilterState, b: FilterState) {
      return a.category === b.category && a.group === b.group && a.minExperience === b.minExperience && a.query === b.query;
    }

    function pushFilterState() {
      const state = currentFilterState();
      if (filterHistory.length > 0 && sameFilterState(filterHistory[filterHistory.length - 1], state)) return;
      filterHistory.push(state);
      updateResetFilterButton();
    }

    function restoreFilterState(state: FilterState) {
      activeCategory = state.category;
      activeGroup = state.group;
      minExperience = state.minExperience;
      textQuery = state.query;
      applySkillFilters();
    }

    function applyFilterChange(change: () => void) {
      const before = currentFilterState();
      change();
      if (!sameFilterState(before, currentFilterState())) filterHistory.push(before);
      applySkillFilters();
    }

    function goBackFilter() {
      const previous = filterHistory.pop();
      if (!previous) return;
      restoreFilterState(previous);
    }

    function applySkillFilters() {
      const normalizedQuery = normalizeText(textQuery);
      const visibleSkills = skills.filter((skill) => {
        const matchesCategory = activeCategory === 'todos' || skill.category === activeCategory;
        const matchesGroup = activeGroup === 'todos' || skill.group === activeGroup;
        const matchesExperience = skill.years >= minExperience;
        const matchesText = normalizedQuery.length === 0 || [skill.name, skill.group, skill.category, skill.level, skill.experience].some((value) => normalizeText(value).includes(normalizedQuery));
        return matchesCategory && matchesGroup && matchesExperience && matchesText;
      });

      drawMap(visibleSkills);
      updateFilterUi();
    }

    function polar(angle: number, radius: number) {
      return { x: Math.cos(angle) * radius, y: Math.sin(angle) * radius };
    }

    function ellipsePoint(angle: number, radius: number) {
      return { x: Math.cos(angle) * radius * ellipseScaleX, y: Math.sin(angle) * radius * ellipseScaleY };
    }

    function clamp(value: number, min: number, max: number) {
      return Math.min(max, Math.max(min, value));
    }

    function groupBy<T>(items: T[], key: (item: T) => string) {
      return items.reduce<Record<string, T[]>>((result, item) => {
        const entry = key(item);
        result[entry] = result[entry] ?? [];
        result[entry].push(item);
        return result;
      }, {});
    }

    function sectorAngle(start: number, span: number, index: number, total: number) {
      if (total <= 1) return start + span / 2;
      return start + span * ((index + 0.5) / total);
    }

    function childSectors<T>(items: T[], weight: (item: T) => number, start = -Math.PI / 2, span = Math.PI * 2) {
      const totalWeight = items.reduce((sum, item) => sum + Math.max(1, weight(item)), 0) || 1;
      let cursor = start;

      return items.map((item) => {
        const itemSpan = span * (Math.max(1, weight(item)) / totalWeight);
        const sector = { item, start: cursor, span: itemSpan, center: cursor + itemSpan / 2 };
        cursor += itemSpan;
        return sector;
      });
    }

    function interleavedPoint(angle: number, radius: number, index: number, intensity = 1) {
      const point = ellipsePoint(angle, radius);
      const verticalBias = Math.abs(Math.sin(angle));
      const direction = index % 2 === 0 ? -1 : 1;
      const tier = Math.floor(index / 2) % 2 === 0 ? 1 : 1.65;
      const offset = verticalBias > 0.72 ? direction * tier * 28 * intensity : ((index % 3) - 1) * 8 * intensity;
      let offsetX = Math.cos(angle + Math.PI / 2) * offset;
      let offsetY = Math.sin(angle + Math.PI / 2) * offset;

      if (verticalBias > 0.72) {
        offsetX = offset;
        offsetY = direction * tier * 7 * intensity;
      }

      return {
        x: point.x + offsetX,
        y: point.y + offsetY,
        offsetX,
        offsetY,
      };
    }

    function hideTooltip() {
      if (!tooltip) return;
      tooltip.hidden = true;
    }

    function clearMap() {
      hideTooltip();
      nodes.length = 0;
      links.length = 0;
      linkLayer?.replaceChildren();
      nodeLayer?.replaceChildren();
    }

    function positionTooltip(clientX: number, clientY: number) {
      if (!tooltip || tooltip.hidden) return;
      const rect = skillMap.getBoundingClientRect();
      const localX = clientX - rect.left;
      const localY = clientY - rect.top;
      tooltip.style.left = `${localX}px`;
      tooltip.style.top = `${localY}px`;
      tooltip.style.setProperty('--tooltip-x', localX > rect.width / 2 ? 'calc(-100% - 14px)' : '14px');
      tooltip.style.setProperty('--tooltip-y', localY > rect.height / 2 ? 'calc(-100% - 14px)' : '14px');
    }

    function showTooltip(node: MapNode, clientX: number, clientY: number) {
      if (!tooltip || node.type !== 'skill') return;
      tooltip.innerHTML = `<strong>${node.label}</strong><span>Nivel: ${node.level ?? '-'}</span><span>Experiencia: ${node.experience ?? '-'}</span>`;
      tooltip.hidden = false;
      positionTooltip(clientX, clientY);
    }

    function showTooltipAtNode(node: MapNode) {
      if (!node.element) return;
      const rect = node.element.getBoundingClientRect();
      showTooltip(node, rect.left + rect.width / 2, rect.top + rect.height / 2);
    }

    function setCategoryFilter(category: string) {
      applyFilterChange(() => {
        activeCategory = category;
        activeGroup = 'todos';
      });
    }

    function setGroupFilter(category: string, group: string) {
      applyFilterChange(() => {
        activeCategory = category;
        activeGroup = group;
      });
    }

    function resetView() {
      panX = 0;
      panY = 0;
      zoom = 1;
      updateViewport();
    }

    function zoomFromCenter(factor: number) {
      zoom = clamp(zoom * factor, 0.48, 2.35);
      updateViewport();
    }

    function toggleHelp() {
      if (!helpPanel || !toggleHelpButton) return;
      const isHidden = helpPanel.hidden;
      helpPanel.hidden = !isHidden;
      toggleHelpButton.classList.toggle('active', isHidden);
    }

    function applyNodeFilter(node: MapNode) {
      if (node.type === 'category' && node.category) setCategoryFilter(node.category);
      if (node.type === 'group' && node.category && node.group) setGroupFilter(node.category, node.group);
    }

    function addNode(node: MapNode) {
      nodes.push(node);
      const item = document.createElementNS(ns, 'g');
      const shape = document.createElementNS(ns, 'rect');
      const label = document.createElementNS(ns, 'text');

      item.classList.add('skill-map-node', `is-${node.type}`);
      if (node.type === 'category' || node.type === 'group') item.classList.add('is-filterable');
      if (node.level) item.classList.add(`level-${node.level.toLowerCase()}`);
      item.dataset.nodeId = node.id;
      item.setAttribute('tabindex', node.type === 'skill' || node.type === 'category' || node.type === 'group' ? '0' : '-1');
      if (node.type === 'category' || node.type === 'group') item.setAttribute('role', 'button');
      label.textContent = node.type === 'skill' && node.label.length > 24 ? `${node.label.slice(0, 22)}...` : node.label;
      label.classList.add('skill-map-label');

      const nodeHeight = node.type === 'root' ? 42 : node.type === 'category' ? 36 : node.type === 'group' ? 31 : 26;
      const minWidth = node.type === 'root' ? 96 : node.type === 'category' ? 104 : node.type === 'group' ? 86 : 56;
      const maxWidth = node.type === 'skill' ? 190 : 220;
      const width = clamp(node.label.length * 7.4 + 28, minWidth, maxWidth);
      node.width = width;
      node.height = nodeHeight;

      shape.setAttribute('x', `${-width / 2}`);
      shape.setAttribute('y', `${-nodeHeight / 2}`);
      shape.setAttribute('width', `${width}`);
      shape.setAttribute('height', `${nodeHeight}`);
      shape.setAttribute('rx', `${nodeHeight / 2}`);
      label.setAttribute('y', '4');

      item.append(shape, label);
      item.addEventListener('mouseenter', (event) => {
        highlightBranch(node.id);
        if (node.type === 'skill') showTooltip(node, event.clientX, event.clientY);
      });
      item.addEventListener('mousemove', (event) => {
        if (node.type === 'skill') positionTooltip(event.clientX, event.clientY);
      });
      item.addEventListener('mouseleave', () => {
        clearHighlight();
        hideTooltip();
      });
      item.addEventListener('focus', () => {
        highlightBranch(node.id);
        if (node.type === 'skill') showTooltipAtNode(node);
      });
      item.addEventListener('blur', () => {
        clearHighlight();
        hideTooltip();
      });
      item.addEventListener('pointerdown', (event) => event.stopPropagation());
      item.addEventListener('click', (event) => {
        event.stopPropagation();
        applyNodeFilter(node);
      });
      item.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        applyNodeFilter(node);
      });
      nodeLayer?.append(item);
      node.element = item;
    }

    function addLink(source: string, target: string) {
      const link = document.createElementNS(ns, 'path');
      link.classList.add('skill-map-link');
      link.dataset.source = source;
      link.dataset.target = target;
      linkLayer?.append(link);
      links.push({ source, target, element: link });
    }

    function addSkillNode(skill: Skill, id: string, parent: string, angle: number, point: { x: number; y: number; offsetX: number; offsetY: number }, radius: number) {
      addNode({ id, parent, type: 'skill', label: skill.name, category: skill.category, group: skill.group, experience: skill.experience, level: skill.level, weight: skill.weight, angle, radius, offsetX: point.offsetX, offsetY: point.offsetY, x: point.x, y: point.y, baseX: point.x, baseY: point.y });
      addLink(parent, id);
    }

    function drawMap(visibleSkills: Skill[]) {
      cancelAnimationFrame(animationId);
      clearMap();
      const width = skillMap.clientWidth;
      const height = clamp(width * 0.72, 620, 860);
      const horizontalPadding = 180;
      const verticalPadding = 130;
      const ellipseWidth = Math.max(width - horizontalPadding, width * 0.58);
      const ellipseHeight = Math.max(height - verticalPadding, height * 0.58);
      const aspect = clamp(ellipseWidth / ellipseHeight, 0.86, 1.9);
      ellipseScaleX = Math.sqrt(aspect);
      ellipseScaleY = 1 / ellipseScaleX;
      const layoutBase = Math.min(ellipseWidth / ellipseScaleX, ellipseHeight / ellipseScaleY);
      const categoryRadius = clamp(layoutBase * 0.13, 92, 154);
      const groupRadius = clamp(layoutBase * 0.28, 230, 380);
      const skillRadius = clamp(layoutBase * 0.43, 360, 610);
      const categories = Object.entries(groupBy(visibleSkills, (skill) => skill.category)).sort(([a], [b]) => a.localeCompare(b, 'es'));
      const selectedCategoryValue = activeCategory;
      const selectedGroupValue = activeGroup;
      const mode = selectedGroupValue !== 'todos' ? 'group' : selectedCategoryValue !== 'todos' ? 'category' : 'all';

      skillMap.style.setProperty('--skill-map-height', `${Math.round(height)}px`);
      svg?.setAttribute('viewBox', `${-width / 2} ${-height / 2} ${width} ${height}`);

      if (mode === 'group') {
        const groupLabel = selectedGroupValue;
        const rootId = `group-root:${groupLabel}`;
        const rootSkills = visibleSkills.sort((a, b) => a.name.localeCompare(b.name, 'es'));

        addNode({ id: rootId, type: 'group', label: groupLabel, category: selectedCategoryValue, group: groupLabel, angle: 0, radius: 0, offsetX: 0, offsetY: 0, x: 0, y: 0, baseX: 0, baseY: 0 });
        rootSkills.forEach((skill, skillIndex) => {
          const skillAngle = sectorAngle(-Math.PI / 2, Math.PI * 2, skillIndex, rootSkills.length);
          const skillPoint = interleavedPoint(skillAngle, categoryRadius + (skillIndex % 3) * 34, skillIndex, 1.15);
          addSkillNode(skill, `${rootId}:skill:${skill.name}`, rootId, skillAngle, skillPoint, categoryRadius);
        });
      } else if (mode === 'category') {
        const categoryLabel = selectedCategoryValue;
        const rootId = `category-root:${categoryLabel}`;
        const groups = Object.entries(groupBy(visibleSkills, (skill) => skill.group)).sort(([a], [b]) => a.localeCompare(b, 'es'));

        addNode({ id: rootId, type: 'category', label: categoryLabel, category: categoryLabel, angle: 0, radius: 0, offsetX: 0, offsetY: 0, x: 0, y: 0, baseX: 0, baseY: 0 });
        childSectors(groups, ([, groupSkills]) => groupSkills.length).forEach(({ item: [group, groupSkills], start, span, center }, groupIndex) => {
          const groupAngle = center;
          const groupPoint = interleavedPoint(groupAngle, categoryRadius, groupIndex, 0.8);
          const groupId = `${rootId}:group:${group}`;

          addNode({ id: groupId, parent: rootId, type: 'group', label: group, category: categoryLabel, group, angle: groupAngle, radius: categoryRadius, offsetX: groupPoint.offsetX, offsetY: groupPoint.offsetY, x: groupPoint.x, y: groupPoint.y, baseX: groupPoint.x, baseY: groupPoint.y });
          addLink(rootId, groupId);

          groupSkills.sort((a, b) => a.name.localeCompare(b.name, 'es')).forEach((skill, skillIndex) => {
            const skillPadding = Math.min(span * 0.12, 0.18);
            const skillAngle = sectorAngle(start + skillPadding, Math.max(0, span - skillPadding * 2), skillIndex, groupSkills.length);
            const skillPoint = interleavedPoint(skillAngle, groupRadius + (skillIndex % 3) * 34, skillIndex, 1.15);
            addSkillNode(skill, `${groupId}:skill:${skill.name}`, groupId, skillAngle, skillPoint, groupRadius);
          });
        });
      } else {
        addNode({ id: 'root', type: 'root', label: 'Skills', angle: 0, radius: 0, offsetX: 0, offsetY: 0, x: 0, y: 0, baseX: 0, baseY: 0 });

        childSectors(categories, ([, categorySkills]) => categorySkills.length).forEach(({ item: [category, categorySkills], start: categoryStart, span: categorySpan, center: angle }, categoryIndex) => {
          const categoryPoint = interleavedPoint(angle, categoryRadius, categoryIndex, 0.65);
          const categoryId = `category:${category}`;
          const groups = Object.entries(groupBy(categorySkills, (skill) => skill.group)).sort(([a], [b]) => a.localeCompare(b, 'es'));

          addNode({ id: categoryId, parent: 'root', type: 'category', label: category, category, angle, radius: categoryRadius, offsetX: categoryPoint.offsetX, offsetY: categoryPoint.offsetY, x: categoryPoint.x, y: categoryPoint.y, baseX: categoryPoint.x, baseY: categoryPoint.y });
          addLink('root', categoryId);

          const categoryPadding = Math.min(categorySpan * 0.08, 0.16);
          childSectors(groups, ([, groupSkills]) => groupSkills.length, categoryStart + categoryPadding, Math.max(0, categorySpan - categoryPadding * 2)).forEach(({ item: [group, groupSkills], start: groupStart, span: groupSpan, center: groupAngle }, groupIndex) => {
            const groupPoint = interleavedPoint(groupAngle, groupRadius, groupIndex, 0.9);
            const groupId = `${categoryId}:group:${group}`;

            addNode({ id: groupId, parent: categoryId, type: 'group', label: group, category, group, angle: groupAngle, radius: groupRadius, offsetX: groupPoint.offsetX, offsetY: groupPoint.offsetY, x: groupPoint.x, y: groupPoint.y, baseX: groupPoint.x, baseY: groupPoint.y });
            addLink(categoryId, groupId);

            groupSkills.sort((a, b) => a.name.localeCompare(b.name, 'es')).forEach((skill, skillIndex) => {
              const skillPadding = Math.min(groupSpan * 0.12, 0.12);
              const skillAngle = sectorAngle(groupStart + skillPadding, Math.max(0, groupSpan - skillPadding * 2), skillIndex, groupSkills.length);
              const skillPoint = interleavedPoint(skillAngle, skillRadius + (skillIndex % 3) * 34, skillIndex, 1.2);
              addSkillNode(skill, `${groupId}:skill:${skill.name}`, groupId, skillAngle, skillPoint, skillRadius);
            });
          });
        });
      }

      resetView();
      rotation = 0;
      renderFrame();
    }

    experienceFilter?.addEventListener('input', () => {
      minExperience = experienceSteps[Number(experienceFilter.value)] ?? 0;
      applySkillFilters();
    });
    experienceFilter?.addEventListener('pointerdown', () => {
      if (sliderHistoryArmed) return;
      pushFilterState();
      sliderHistoryArmed = true;
    });
    experienceFilter?.addEventListener('change', () => {
      sliderHistoryArmed = false;
    });
    textFilter?.addEventListener('input', () => {
      if (!textHistoryArmed) {
        pushFilterState();
        textHistoryArmed = true;
      }

      textQuery = textFilter.value.trim();
      applySkillFilters();
    });
    textFilter?.addEventListener('change', () => {
      textHistoryArmed = false;
    });
    textFilter?.addEventListener('blur', () => {
      textHistoryArmed = false;
    });
    clearTextButton?.addEventListener('click', () => {
      if (!textQuery) return;
      applyFilterChange(() => {
        textQuery = '';
      });
    });

    resetViewButton?.addEventListener('click', resetView);
    backFilterButton?.addEventListener('click', goBackFilter);
    zoomInButton?.addEventListener('click', () => zoomFromCenter(1.15));
    zoomOutButton?.addEventListener('click', () => zoomFromCenter(0.85));
    toggleHelpButton?.addEventListener('click', toggleHelp);
    resetViewButton?.addEventListener('pointerdown', (event) => event.stopPropagation());
    backFilterButton?.addEventListener('pointerdown', (event) => event.stopPropagation());
    zoomInButton?.addEventListener('pointerdown', (event) => event.stopPropagation());
    zoomOutButton?.addEventListener('pointerdown', (event) => event.stopPropagation());
    toggleHelpButton?.addEventListener('pointerdown', (event) => event.stopPropagation());
    experienceFilter?.addEventListener('pointerdown', (event) => event.stopPropagation());
    textFilter?.addEventListener('pointerdown', (event) => event.stopPropagation());
    clearTextButton?.addEventListener('pointerdown', (event) => event.stopPropagation());

    window.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !helpPanel || helpPanel.hidden) return;
      helpPanel.hidden = true;
      toggleHelpButton?.classList.remove('active');
    });

    updateFilterUi();
    applySkillFilters();

    function updateViewport() {
      viewport?.setAttribute('transform', `translate(${panX} ${panY}) scale(${zoom})`);
    }

    function trimmedLinkPath(source: MapNode, target: MapNode) {
      const dx = target.x - source.x;
      const dy = target.y - source.y;
      const distance = Math.hypot(dx, dy) || 1;
      const start = nodeEdgePoint(source, target);
      const end = nodeEdgePoint(target, source);
      const bend = Math.min(distance * 0.18, 72);
      const sourceAngle = Math.atan2(source.y, source.x);
      const targetAngle = Math.atan2(target.y, target.x);
      const control1 = {
        x: start.x + Math.cos(source.radius === 0 ? Math.atan2(dy, dx) : sourceAngle) * bend,
        y: start.y + Math.sin(source.radius === 0 ? Math.atan2(dy, dx) : sourceAngle) * bend,
      };
      const control2 = {
        x: end.x - Math.cos(target.radius === 0 ? Math.atan2(dy, dx) : targetAngle) * bend,
        y: end.y - Math.sin(target.radius === 0 ? Math.atan2(dy, dx) : targetAngle) * bend,
      };

      return `M ${start.x} ${start.y} C ${control1.x} ${control1.y} ${control2.x} ${control2.y} ${end.x} ${end.y}`;
    }

    function nodeEdgePoint(node: MapNode, toward: MapNode) {
      const dx = toward.x - node.x;
      const dy = toward.y - node.y;
      const halfWidth = (node.width ?? 80) / 2 + 3;
      const halfHeight = (node.height ?? 28) / 2 + 3;
      const scale = Math.min(halfWidth / Math.max(Math.abs(dx), 0.001), halfHeight / Math.max(Math.abs(dy), 0.001));

      return {
        x: node.x + dx * scale,
        y: node.y + dy * scale,
      };
    }

    function renderFrame() {
      time += reduceMotion ? 0 : 0.012;
      rotation += reduceMotion ? 0 : 0.00035;
      const byId = Object.fromEntries(nodes.map((node) => [node.id, node]));

      nodes.forEach((node, index) => {
        const drift = reduceMotion || node.type === 'root' ? 0 : Math.sin(time + index * 0.7) * (node.type === 'skill' ? 5 : 2.4);
        const orbit = ellipsePoint(node.angle - rotation, node.radius);
        node.x = orbit.x + node.offsetX + Math.cos(node.angle + Math.PI / 2) * drift;
        node.y = orbit.y + node.offsetY + Math.sin(node.angle + Math.PI / 2) * drift;
        node.element?.setAttribute('transform', `translate(${node.x} ${node.y})`);
      });

      links.forEach((link) => {
        const source = byId[link.source];
        const target = byId[link.target];
        if (!source || !target) return;
        link.element?.setAttribute('d', trimmedLinkPath(source, target));
      });

      animationId = requestAnimationFrame(renderFrame);
    }

    function branchIds(nodeId: string) {
      const ids = new Set([nodeId]);
      let changed = true;

      while (changed) {
        changed = false;
        nodes.forEach((node) => {
          if (node.parent && ids.has(node.parent) && !ids.has(node.id)) {
            ids.add(node.id);
            changed = true;
          }
        });
      }

      let parent = nodes.find((node) => node.id === nodeId)?.parent;
      while (parent) {
        ids.add(parent);
        parent = nodes.find((node) => node.id === parent)?.parent;
      }

      return ids;
    }

    function highlightBranch(nodeId: string) {
      const ids = branchIds(nodeId);
      skillMap.classList.add('is-dimmed');
      nodes.forEach((node) => node.element?.classList.toggle('is-active', ids.has(node.id)));
      links.forEach((link) => link.element?.classList.toggle('is-active', ids.has(link.source) && ids.has(link.target)));
    }

    function clearHighlight() {
      skillMap.classList.remove('is-dimmed');
      nodes.forEach((node) => node.element?.classList.remove('is-active'));
      links.forEach((link) => link.element?.classList.remove('is-active'));
    }

    skillMap.addEventListener('pointerdown', (event) => {
      isPanning = true;
      hideTooltip();
      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
      skillMap.setPointerCapture(event.pointerId);
    });

    skillMap.addEventListener('pointermove', (event) => {
      if (!isPanning) return;
      const deltaX = event.clientX - lastPointerX;
      const deltaY = event.clientY - lastPointerY;

      panX += deltaX;
      panY += deltaY;
      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
      updateViewport();
    }, { passive: true });

    skillMap.addEventListener('pointerup', (event) => {
      isPanning = false;
      skillMap.releasePointerCapture(event.pointerId);
    });

    skillMap.addEventListener('pointerleave', () => {
      isPanning = false;
      hideTooltip();
    });

    skillMap.addEventListener('contextmenu', (event) => {
      event.preventDefault();
      hideTooltip();
      goBackFilter();
    });

    window.addEventListener('resize', () => {
      applySkillFilters();
    });
  }
</script>
