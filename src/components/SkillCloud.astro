---
import { technicalSkills } from '../data/skills';

const sortedSkills = [...technicalSkills].sort((a, b) => a.name.localeCompare(b.name, 'es'));

function experienceWeight(experience: string) {
  const value = Number(experience.match(/\d+/)?.[0] ?? 1);
  if (value >= 20) return 5;
  if (value >= 15) return 4;
  if (value >= 10) return 3;
  if (value >= 5) return 2;
  return 1;
}
---

<div class="skill-map" data-skill-map>
  <div class="skill-map-legend">
    <strong>Cómo explorar</strong>
    <span>Click en categoría o sub-categoría para filtrar.</span>
    <span>Hover sobre una skill para ver stats.</span>
    <span>Arrastrá para mover, rueda para zoom.</span>
    <small data-skill-filter-summary>Filtro: todos</small>
  </div>
  <div class="skill-map-controls" aria-label="Controles del mapa de skills">
    <button class="filter-button map-control" type="button" data-skill-reset-view>Reset vista</button>
    <button class="filter-button map-control" type="button" data-skill-reset-filter disabled>Deshacer filtro</button>
  </div>
  <div class="skill-map-filter-strip" aria-label="Filtros de experiencia y nivel">
    <label class="range-control">
      <span>Experiencia mínima: <strong data-skill-experience-value>0 años</strong></span>
      <input type="range" min="0" max="8" value="0" step="1" data-skill-experience-filter />
    </label>
    <div class="level-filter" data-skill-level-filter>
      <button class="filter-button active" type="button" data-skill-level="todos">Todos</button>
      <button class="filter-button" type="button" data-skill-level="basico">Básico+</button>
      <button class="filter-button" type="button" data-skill-level="intermedio">Intermedio+</button>
      <button class="filter-button" type="button" data-skill-level="avanzado">Avanzado+</button>
      <button class="filter-button" type="button" data-skill-level="experto">Experto</button>
    </div>
  </div>
  <svg class="skill-map-svg" data-skill-map-svg role="img" aria-label="Mapa radial de skills por categoría y sub-categoría">
    <g data-skill-map-viewport>
      <g data-skill-map-links></g>
      <g data-skill-map-nodes></g>
    </g>
  </svg>
  <div class="skill-map-tooltip" data-skill-tooltip hidden></div>
</div>

<script type="application/json" data-skill-data set:html={JSON.stringify(sortedSkills.map((skill) => ({ ...skill, weight: experienceWeight(skill.experience) })))} />

<script>
  const skillMap = document.querySelector<HTMLElement>('[data-skill-map]');
  const skillData = document.querySelector<HTMLScriptElement>('[data-skill-data]');

  if (skillMap && skillData) {
    type Skill = { category: string; group: string; name: string; experience: string; level: string; weight: number; years: number; levelRank: number };
    type MapNode = { id: string; parent?: string; type: string; label: string; category?: string; group?: string; experience?: string; level?: string; weight?: number; angle: number; radius: number; x: number; y: number; baseX: number; baseY: number; element?: SVGGElement };

    const svg = skillMap.querySelector<SVGSVGElement>('[data-skill-map-svg]');
    const viewport = skillMap.querySelector<SVGGElement>('[data-skill-map-viewport]');
    const linkLayer = skillMap.querySelector<SVGGElement>('[data-skill-map-links]');
    const nodeLayer = skillMap.querySelector<SVGGElement>('[data-skill-map-nodes]');
    const resetViewButton = skillMap.querySelector<HTMLButtonElement>('[data-skill-reset-view]');
    const resetFilterButton = skillMap.querySelector<HTMLButtonElement>('[data-skill-reset-filter]');
    const experienceFilter = skillMap.querySelector<HTMLInputElement>('[data-skill-experience-filter]');
    const experienceValue = skillMap.querySelector<HTMLElement>('[data-skill-experience-value]');
    const levelButtons = skillMap.querySelectorAll<HTMLButtonElement>('[data-skill-level]');
    const filterSummary = skillMap.querySelector<HTMLElement>('[data-skill-filter-summary]');
    const tooltip = skillMap.querySelector<HTMLElement>('[data-skill-tooltip]');
    const rawSkills = JSON.parse(skillData.textContent || '[]') as Array<Omit<Skill, 'years' | 'levelRank'>>;
    const experienceSteps = [0, 1, 2, 3, 5, 10, 15, 20, 25];
    const levelRanks: Record<string, number> = { basico: 1, básico: 1, intermedio: 2, avanzado: 3, experto: 4, todos: 0 };
    const skills = rawSkills.map((skill) => ({ ...skill, years: experienceYears(skill.experience), levelRank: rankLevel(skill.level) }));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ns = 'http://www.w3.org/2000/svg';
    const nodes: MapNode[] = [];
    const links: Array<{ source: string; target: string; element?: SVGPathElement }> = [];
    let animationId = 0;
    let panX = 0;
    let panY = 0;
    let zoom = 1;
    let isPanning = false;
    let lastPointerX = 0;
    let lastPointerY = 0;
    let time = 0;
    let activeCategory = 'todos';
    let activeGroup = 'todos';
    let activeLevel = 'todos';
    let minExperience = 0;

    function normalizeLevel(level: string) {
      return level.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function rankLevel(level: string) {
      return levelRanks[normalizeLevel(level)] ?? 0;
    }

    function experienceYears(experience: string) {
      if (experience.includes('<')) return 0;
      return Number(experience.match(/\d+/)?.[0] ?? 0);
    }

    function updateResetFilterButton() {
      if (!resetFilterButton) return;
      resetFilterButton.disabled = activeCategory === 'todos' && activeGroup === 'todos' && activeLevel === 'todos' && minExperience === 0;
    }

    function updateFilterSummary() {
      if (!filterSummary) return;
      const parts = [];
      if (activeCategory !== 'todos') parts.push(activeCategory);
      if (activeGroup !== 'todos') parts.push(activeGroup);
      if (minExperience > 0) parts.push(`+${minExperience} años`);
      if (activeLevel !== 'todos') parts.push(`${levelLabel(activeLevel)}+`);
      filterSummary.textContent = `Filtro: ${parts.length > 0 ? parts.join(' / ') : 'todos'}`;
    }

    function levelLabel(level: string) {
      const labels: Record<string, string> = { basico: 'Básico', intermedio: 'Intermedio', avanzado: 'Avanzado', experto: 'Experto', todos: 'Todos' };
      return labels[level] ?? level;
    }

    function updateFilterUi() {
      if (experienceFilter) experienceFilter.value = `${experienceSteps.indexOf(minExperience)}`;
      if (experienceValue) experienceValue.textContent = minExperience === 0 ? '0 años' : `+${minExperience} años`;
      levelButtons.forEach((button) => button.classList.toggle('active', button.getAttribute('data-skill-level') === activeLevel));
      updateResetFilterButton();
      updateFilterSummary();
    }

    function applySkillFilters() {
      const visibleSkills = skills.filter((skill) => {
        const matchesCategory = activeCategory === 'todos' || skill.category === activeCategory;
        const matchesGroup = activeGroup === 'todos' || skill.group === activeGroup;
        const matchesExperience = skill.years >= minExperience;
        const matchesLevel = activeLevel === 'todos' || skill.levelRank >= (levelRanks[activeLevel] ?? 0);
        return matchesCategory && matchesGroup && matchesExperience && matchesLevel;
      });

      drawMap(visibleSkills);
      updateFilterUi();
    }

    function polar(angle: number, radius: number) {
      return { x: Math.cos(angle) * radius, y: Math.sin(angle) * radius };
    }

    function clamp(value: number, min: number, max: number) {
      return Math.min(max, Math.max(min, value));
    }

    function groupBy<T>(items: T[], key: (item: T) => string) {
      return items.reduce<Record<string, T[]>>((result, item) => {
        const entry = key(item);
        result[entry] = result[entry] ?? [];
        result[entry].push(item);
        return result;
      }, {});
    }

    function interleavedPoint(angle: number, radius: number, index: number, intensity = 1) {
      const point = polar(angle, radius);
      const verticalBias = Math.abs(Math.sin(angle));
      const direction = index % 2 === 0 ? -1 : 1;
      const tier = Math.floor(index / 2) % 2 === 0 ? 1 : 1.65;
      const offset = verticalBias > 0.72 ? direction * tier * 22 * intensity : ((index % 3) - 1) * 8 * intensity;
      return {
        x: point.x + Math.cos(angle + Math.PI / 2) * offset,
        y: point.y + Math.sin(angle + Math.PI / 2) * offset,
      };
    }

    function hideTooltip() {
      if (!tooltip) return;
      tooltip.hidden = true;
    }

    function clearMap() {
      hideTooltip();
      nodes.length = 0;
      links.length = 0;
      linkLayer?.replaceChildren();
      nodeLayer?.replaceChildren();
    }

    function positionTooltip(clientX: number, clientY: number) {
      if (!tooltip || tooltip.hidden) return;
      const rect = skillMap.getBoundingClientRect();
      const localX = clientX - rect.left;
      const localY = clientY - rect.top;
      tooltip.style.left = `${localX}px`;
      tooltip.style.top = `${localY}px`;
      tooltip.style.setProperty('--tooltip-x', localX > rect.width / 2 ? 'calc(-100% - 14px)' : '14px');
      tooltip.style.setProperty('--tooltip-y', localY > rect.height / 2 ? 'calc(-100% - 14px)' : '14px');
    }

    function showTooltip(node: MapNode, clientX: number, clientY: number) {
      if (!tooltip || node.type !== 'skill') return;
      tooltip.innerHTML = `<strong>${node.label}</strong><span>Nivel: ${node.level ?? '-'}</span><span>Experiencia: ${node.experience ?? '-'}</span>`;
      tooltip.hidden = false;
      positionTooltip(clientX, clientY);
    }

    function showTooltipAtNode(node: MapNode) {
      if (!node.element) return;
      const rect = node.element.getBoundingClientRect();
      showTooltip(node, rect.left + rect.width / 2, rect.top + rect.height / 2);
    }

    function setCategoryFilter(category: string) {
      activeCategory = category;
      activeGroup = 'todos';
      applySkillFilters();
    }

    function setGroupFilter(category: string, group: string) {
      activeCategory = category;
      activeGroup = group;
      applySkillFilters();
    }

    function resetFilters() {
      activeCategory = 'todos';
      activeGroup = 'todos';
      activeLevel = 'todos';
      minExperience = 0;
      applySkillFilters();
    }

    function resetView() {
      panX = 0;
      panY = 0;
      zoom = 1;
      updateViewport();
    }

    function applyNodeFilter(node: MapNode) {
      if (node.type === 'category' && node.category) setCategoryFilter(node.category);
      if (node.type === 'group' && node.category && node.group) setGroupFilter(node.category, node.group);
    }

    function addNode(node: MapNode) {
      nodes.push(node);
      const item = document.createElementNS(ns, 'g');
      const shape = document.createElementNS(ns, 'rect');
      const label = document.createElementNS(ns, 'text');

      item.classList.add('skill-map-node', `is-${node.type}`);
      if (node.type === 'category' || node.type === 'group') item.classList.add('is-filterable');
      if (node.level) item.classList.add(`level-${node.level.toLowerCase()}`);
      item.dataset.nodeId = node.id;
      item.setAttribute('tabindex', node.type === 'skill' || node.type === 'category' || node.type === 'group' ? '0' : '-1');
      if (node.type === 'category' || node.type === 'group') item.setAttribute('role', 'button');
      label.textContent = node.type === 'skill' && node.label.length > 24 ? `${node.label.slice(0, 22)}...` : node.label;
      label.classList.add('skill-map-label');

      const nodeHeight = node.type === 'root' ? 42 : node.type === 'category' ? 36 : node.type === 'group' ? 31 : 26;
      const minWidth = node.type === 'root' ? 96 : node.type === 'category' ? 104 : node.type === 'group' ? 86 : 56;
      const maxWidth = node.type === 'skill' ? 190 : 220;
      const width = clamp(node.label.length * 7.4 + 28, minWidth, maxWidth);

      shape.setAttribute('x', `${-width / 2}`);
      shape.setAttribute('y', `${-nodeHeight / 2}`);
      shape.setAttribute('width', `${width}`);
      shape.setAttribute('height', `${nodeHeight}`);
      shape.setAttribute('rx', `${nodeHeight / 2}`);
      label.setAttribute('y', '4');

      item.append(shape, label);
      item.addEventListener('mouseenter', (event) => {
        highlightBranch(node.id);
        if (node.type === 'skill') showTooltip(node, event.clientX, event.clientY);
      });
      item.addEventListener('mousemove', (event) => {
        if (node.type === 'skill') positionTooltip(event.clientX, event.clientY);
      });
      item.addEventListener('mouseleave', () => {
        clearHighlight();
        hideTooltip();
      });
      item.addEventListener('focus', () => {
        highlightBranch(node.id);
        if (node.type === 'skill') showTooltipAtNode(node);
      });
      item.addEventListener('blur', () => {
        clearHighlight();
        hideTooltip();
      });
      item.addEventListener('pointerdown', (event) => event.stopPropagation());
      item.addEventListener('click', (event) => {
        event.stopPropagation();
        applyNodeFilter(node);
      });
      item.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        applyNodeFilter(node);
      });
      nodeLayer?.append(item);
      node.element = item;
    }

    function addLink(source: string, target: string) {
      const link = document.createElementNS(ns, 'path');
      link.classList.add('skill-map-link');
      link.dataset.source = source;
      link.dataset.target = target;
      linkLayer?.append(link);
      links.push({ source, target, element: link });
    }

    function addSkillNode(skill: Skill, id: string, parent: string, angle: number, point: { x: number; y: number }, radius: number) {
      addNode({ id, parent, type: 'skill', label: skill.name, category: skill.category, group: skill.group, experience: skill.experience, level: skill.level, weight: skill.weight, angle, radius, x: point.x, y: point.y, baseX: point.x, baseY: point.y });
      addLink(parent, id);
    }

    function drawMap(visibleSkills: Skill[]) {
      cancelAnimationFrame(animationId);
      clearMap();
      const width = skillMap.clientWidth;
      const height = clamp(460 + visibleSkills.length * 6, 520, 900);
      const categoryRadius = clamp(Math.min(width, height) * 0.22, 128, 190);
      const groupRadius = clamp(Math.min(width, height) * 0.4, 230, 340);
      const skillRadius = clamp(Math.min(width, height) * 0.62, 360, 560);
      const categories = Object.entries(groupBy(visibleSkills, (skill) => skill.category)).sort(([a], [b]) => a.localeCompare(b, 'es'));
      const selectedCategoryValue = activeCategory;
      const selectedGroupValue = activeGroup;
      const mode = selectedGroupValue !== 'todos' ? 'group' : selectedCategoryValue !== 'todos' ? 'category' : 'all';

      skillMap.style.setProperty('--skill-map-height', `${Math.round(height)}px`);
      svg?.setAttribute('viewBox', `${-width / 2} ${-height / 2} ${width} ${height}`);

      if (mode === 'group') {
        const groupLabel = selectedGroupValue;
        const rootId = `group-root:${groupLabel}`;
        const rootSkills = visibleSkills.sort((a, b) => a.name.localeCompare(b.name, 'es'));

        addNode({ id: rootId, type: 'group', label: groupLabel, category: selectedCategoryValue, group: groupLabel, angle: 0, radius: 0, x: 0, y: 0, baseX: 0, baseY: 0 });
        rootSkills.forEach((skill, skillIndex) => {
          const skillAngle = -Math.PI / 2 + (Math.PI * 2 * skillIndex) / Math.max(rootSkills.length, 1);
          const skillPoint = interleavedPoint(skillAngle, categoryRadius + (skillIndex % 3) * 34, skillIndex, 1.15);
          addSkillNode(skill, `${rootId}:skill:${skill.name}`, rootId, skillAngle, skillPoint, categoryRadius);
        });
      } else if (mode === 'category') {
        const categoryLabel = selectedCategoryValue;
        const rootId = `category-root:${categoryLabel}`;
        const groups = Object.entries(groupBy(visibleSkills, (skill) => skill.group)).sort(([a], [b]) => a.localeCompare(b, 'es'));

        addNode({ id: rootId, type: 'category', label: categoryLabel, category: categoryLabel, angle: 0, radius: 0, x: 0, y: 0, baseX: 0, baseY: 0 });
        groups.forEach(([group, groupSkills], groupIndex) => {
          const groupAngle = -Math.PI / 2 + (Math.PI * 2 * groupIndex) / Math.max(groups.length, 1);
          const groupPoint = interleavedPoint(groupAngle, categoryRadius, groupIndex, 0.8);
          const groupId = `${rootId}:group:${group}`;

          addNode({ id: groupId, parent: rootId, type: 'group', label: group, category: categoryLabel, group, angle: groupAngle, radius: categoryRadius, x: groupPoint.x, y: groupPoint.y, baseX: groupPoint.x, baseY: groupPoint.y });
          addLink(rootId, groupId);

          groupSkills.sort((a, b) => a.name.localeCompare(b.name, 'es')).forEach((skill, skillIndex) => {
            const skillSpread = Math.PI / Math.max(2.2, groups.length * 0.62);
            const skillAngle = groupAngle - skillSpread / 2 + skillSpread * ((skillIndex + 0.5) / groupSkills.length);
            const skillPoint = interleavedPoint(skillAngle, groupRadius + (skillIndex % 3) * 34, skillIndex, 1.15);
            addSkillNode(skill, `${groupId}:skill:${skill.name}`, groupId, skillAngle, skillPoint, groupRadius);
          });
        });
      } else {
        addNode({ id: 'root', type: 'root', label: 'Skills', angle: 0, radius: 0, x: 0, y: 0, baseX: 0, baseY: 0 });

        categories.forEach(([category, categorySkills], categoryIndex) => {
          const sector = (Math.PI * 2) / Math.max(categories.length, 1);
          const angle = -Math.PI / 2 + categoryIndex * sector;
          const categoryPoint = interleavedPoint(angle, categoryRadius, categoryIndex, 0.65);
          const categoryId = `category:${category}`;
          const groups = Object.entries(groupBy(categorySkills, (skill) => skill.group)).sort(([a], [b]) => a.localeCompare(b, 'es'));

          addNode({ id: categoryId, parent: 'root', type: 'category', label: category, category, angle, radius: categoryRadius, x: categoryPoint.x, y: categoryPoint.y, baseX: categoryPoint.x, baseY: categoryPoint.y });
          addLink('root', categoryId);

          groups.forEach(([group, groupSkills], groupIndex) => {
            const spread = Math.min(sector * 0.9, Math.PI / 1.35);
            const groupAngle = angle - spread / 2 + spread * ((groupIndex + 0.5) / groups.length);
            const groupPoint = interleavedPoint(groupAngle, groupRadius, groupIndex, 0.9);
            const groupId = `${categoryId}:group:${group}`;

            addNode({ id: groupId, parent: categoryId, type: 'group', label: group, category, group, angle: groupAngle, radius: groupRadius, x: groupPoint.x, y: groupPoint.y, baseX: groupPoint.x, baseY: groupPoint.y });
            addLink(categoryId, groupId);

            groupSkills.sort((a, b) => a.name.localeCompare(b.name, 'es')).forEach((skill, skillIndex) => {
              const skillSpread = Math.min(spread / Math.max(groups.length, 1), Math.PI / 2.9);
              const skillAngle = groupAngle - skillSpread / 2 + skillSpread * ((skillIndex + 0.5) / groupSkills.length);
              const skillPoint = interleavedPoint(skillAngle, skillRadius + (skillIndex % 3) * 34, skillIndex, 1.2);
              addSkillNode(skill, `${groupId}:skill:${skill.name}`, groupId, skillAngle, skillPoint, skillRadius);
            });
          });
        });
      }

      resetView();
      renderFrame();
    }

    experienceFilter?.addEventListener('input', () => {
      minExperience = experienceSteps[Number(experienceFilter.value)] ?? 0;
      applySkillFilters();
    });

    levelButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeLevel = button.getAttribute('data-skill-level') || 'todos';
        applySkillFilters();
      });
      button.addEventListener('pointerdown', (event) => event.stopPropagation());
    });

    resetViewButton?.addEventListener('click', resetView);
    resetFilterButton?.addEventListener('click', resetFilters);
    resetViewButton?.addEventListener('pointerdown', (event) => event.stopPropagation());
    resetFilterButton?.addEventListener('pointerdown', (event) => event.stopPropagation());
    experienceFilter?.addEventListener('pointerdown', (event) => event.stopPropagation());

    updateFilterUi();
    applySkillFilters();

    function updateViewport() {
      viewport?.setAttribute('transform', `translate(${panX} ${panY}) scale(${zoom})`);
    }

    function trimmedLinkPath(source: MapNode, target: MapNode) {
      const dx = target.x - source.x;
      const dy = target.y - source.y;
      const distance = Math.hypot(dx, dy) || 1;
      const sourceInset = source.type === 'root' ? 34 : source.type === 'category' ? 42 : 36;
      const targetInset = target.type === 'skill' ? 58 : target.type === 'category' ? 48 : 42;
      const startX = source.x + (dx / distance) * sourceInset;
      const startY = source.y + (dy / distance) * sourceInset;
      const endX = target.x - (dx / distance) * targetInset;
      const endY = target.y - (dy / distance) * targetInset;
      const midX = (startX + endX) / 2;
      const midY = (startY + endY) / 2;
      return `M ${startX} ${startY} Q ${midX * 0.92} ${midY * 0.92} ${endX} ${endY}`;
    }

    function renderFrame() {
      time += reduceMotion ? 0 : 0.012;
      const byId = Object.fromEntries(nodes.map((node) => [node.id, node]));

      nodes.forEach((node, index) => {
        const drift = reduceMotion || node.type === 'root' ? 0 : Math.sin(time + index * 0.7) * (node.type === 'skill' ? 5 : 2.4);
        node.x = node.baseX + Math.cos(node.angle + Math.PI / 2) * drift;
        node.y = node.baseY + Math.sin(node.angle + Math.PI / 2) * drift;
        node.element?.setAttribute('transform', `translate(${node.x} ${node.y})`);
      });

      links.forEach((link) => {
        const source = byId[link.source];
        const target = byId[link.target];
        if (!source || !target) return;
        link.element?.setAttribute('d', trimmedLinkPath(source, target));
      });

      animationId = requestAnimationFrame(renderFrame);
    }

    function branchIds(nodeId: string) {
      const ids = new Set([nodeId]);
      let changed = true;

      while (changed) {
        changed = false;
        nodes.forEach((node) => {
          if (node.parent && ids.has(node.parent) && !ids.has(node.id)) {
            ids.add(node.id);
            changed = true;
          }
        });
      }

      let parent = nodes.find((node) => node.id === nodeId)?.parent;
      while (parent) {
        ids.add(parent);
        parent = nodes.find((node) => node.id === parent)?.parent;
      }

      return ids;
    }

    function highlightBranch(nodeId: string) {
      const ids = branchIds(nodeId);
      skillMap.classList.add('is-dimmed');
      nodes.forEach((node) => node.element?.classList.toggle('is-active', ids.has(node.id)));
      links.forEach((link) => link.element?.classList.toggle('is-active', ids.has(link.source) && ids.has(link.target)));
    }

    function clearHighlight() {
      skillMap.classList.remove('is-dimmed');
      nodes.forEach((node) => node.element?.classList.remove('is-active'));
      links.forEach((link) => link.element?.classList.remove('is-active'));
    }

    skillMap.addEventListener('pointerdown', (event) => {
      isPanning = true;
      hideTooltip();
      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
      skillMap.setPointerCapture(event.pointerId);
    });

    skillMap.addEventListener('pointermove', (event) => {
      if (!isPanning) return;
      const deltaX = event.clientX - lastPointerX;
      const deltaY = event.clientY - lastPointerY;

      panX += deltaX;
      panY += deltaY;
      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
      updateViewport();
    }, { passive: true });

    skillMap.addEventListener('pointerup', (event) => {
      isPanning = false;
      skillMap.releasePointerCapture(event.pointerId);
    });

    skillMap.addEventListener('wheel', (event) => {
      event.preventDefault();
      hideTooltip();
      const previousZoom = zoom;
      const nextZoom = clamp(zoom * (event.deltaY > 0 ? 0.9 : 1.1), 0.48, 2.35);
      const rect = skillMap.getBoundingClientRect();
      const x = event.clientX - rect.left - rect.width / 2;
      const y = event.clientY - rect.top - rect.height / 2;

      zoom = nextZoom;
      panX = x - (x - panX) * (zoom / previousZoom);
      panY = y - (y - panY) * (zoom / previousZoom);
      updateViewport();
    }, { passive: false });

    skillMap.addEventListener('pointerleave', () => {
      isPanning = false;
      hideTooltip();
    });

    window.addEventListener('resize', () => {
      applySkillFilters();
    });
  }
</script>
