---
import { technicalSkills } from '../data/skills';

const categories = ['todos', ...Array.from(new Set(technicalSkills.map((skill) => skill.category))).sort((a, b) => a.localeCompare(b, 'es'))];
const groups = Array.from(new Set(technicalSkills.map((skill) => `${skill.category}::${skill.group}`))).sort((a, b) => a.localeCompare(b, 'es'));
const sortedSkills = [...technicalSkills].sort((a, b) => a.name.localeCompare(b.name, 'es'));

function experienceWeight(experience: string) {
  const value = Number(experience.match(/\d+/)?.[0] ?? 1);
  if (value >= 20) return 5;
  if (value >= 15) return 4;
  if (value >= 10) return 3;
  if (value >= 5) return 2;
  return 1;
}
---

<div class="filter-panel" data-skill-filters>
  <div>
    <p class="filter-label">Categoría</p>
    <div class="filter-bar compact" data-skill-categories>
      {categories.map((category) => <button class:list={["filter-button", { active: category === 'todos' }]} data-skill-category={category}>{category}</button>)}
    </div>
  </div>

  <div>
    <p class="filter-label">Sub-categoría</p>
    <div class="filter-bar compact" data-skill-groups>
      <button class="filter-button active" data-skill-group="todos" data-parent-category="todos">Todas</button>
      {groups.map((entry) => {
        const [category, group] = entry.split('::');
        return <button class="filter-button" data-skill-group={group} data-parent-category={category} hidden>{group}</button>;
      })}
    </div>
  </div>
</div>

<div class="skill-cloud skill-cloud-3d" data-skill-list data-skill-cloud-3d>
  {sortedSkills.map((skill) => (
    <span
      class={`skill-chip filter-item level-${skill.level.toLowerCase()}`}
      data-category={skill.category}
      data-group={skill.group}
      data-weight={experienceWeight(skill.experience)}
      title={`${skill.group} | ${skill.experience} | ${skill.level}`}
    >
      {skill.name}
    </span>
  ))}
</div>

<script>
  import * as THREE from 'three';

  const skillPanel = document.querySelector('[data-skill-filters]');
  const skillList = document.querySelector('[data-skill-list]');

  if (skillPanel && skillList) {
    const categoryButtons = skillPanel.querySelectorAll('[data-skill-category]');
    const groupButtons = skillPanel.querySelectorAll('[data-skill-group]');
    const skills = Array.from(skillList.querySelectorAll<HTMLElement>('.filter-item'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cloud = skillList as HTMLElement;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    const group = new THREE.Group();
    const isMobile = window.matchMedia('(max-width: 780px)').matches;
    const nodes = skills.map((element) => ({ element, point: new THREE.Vector3(), visible: true }));
    let animationId = 0;
    let active = true;
    let isAnimating = false;
    let dragging = false;
    let lastPointerX = 0;
    let lastPointerY = 0;
    let targetRotationX = 0;
    let targetRotationY = 0;

    scene.add(group);
    camera.position.z = 7;

    function fibonacciPoint(index: number, total: number, radius: number) {
      const offset = 2 / total;
      const increment = Math.PI * (3 - Math.sqrt(5));
      const y = index * offset - 1 + offset / 2;
      const distance = Math.sqrt(1 - y * y);
      const phi = index * increment;

      return new THREE.Vector3(
        Math.cos(phi) * distance * radius * 1.72,
        y * radius * 0.68,
        Math.sin(phi) * distance * radius * 0.92,
      );
    }

    function layoutNodes() {
      const visibleNodes = nodes.filter((node) => node.visible);
      const visibleCount = visibleNodes.length;
      const radius = THREE.MathUtils.clamp(1.15 + Math.sqrt(Math.max(visibleCount, 1)) * 0.23, 1.35, isMobile ? 2.35 : 2.85);
      const height = THREE.MathUtils.clamp(190 + visibleCount * (isMobile ? 5.2 : 4.1), isMobile ? 250 : 280, isMobile ? 340 : 390);

      cloud.style.setProperty('--cloud-height', `${Math.round(height)}px`);

      visibleNodes.forEach((node, index) => {
        node.point.copy(fibonacciPoint(index, visibleCount, radius));
      });
    }

    function projectNodes() {
      const width = cloud.clientWidth;
      const height = cloud.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      camera.updateMatrixWorld();
      group.updateMatrixWorld();

      nodes.forEach((node) => {
        const projected = node.point.clone().applyMatrix4(group.matrixWorld).project(camera);
        const x = (projected.x * 0.5 + 0.5) * width;
        const y = (-projected.y * 0.5 + 0.5) * height;
        const depth = THREE.MathUtils.clamp(1 - projected.z, 0, 1);
        const scale = THREE.MathUtils.clamp(0.78 + depth * 0.32, 0.72, 1.2);
        const opacity = node.visible ? THREE.MathUtils.clamp(0.62 + depth * 0.38, 0.62, 1) : 0;

        node.element.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) scale(${scale})`;
        node.element.style.opacity = `${opacity}`;
        node.element.style.pointerEvents = node.visible ? 'auto' : 'none';
        node.element.style.zIndex = `${Math.round((1 - projected.z) * 1000)}`;
      });
    }

    function animate() {
      if (!active || reduceMotion) {
        isAnimating = false;
        return;
      }
      isAnimating = true;
      if (!dragging) targetRotationY += 0.0032;
      group.rotation.y += (targetRotationY - group.rotation.y) * 0.08;
      group.rotation.x += (targetRotationX - group.rotation.x) * 0.08;
      projectNodes();
      animationId = requestAnimationFrame(animate);
    }

    function setCloudMode() {
      cloud.classList.add('is-3d-ready');
      projectNodes();
      if (!reduceMotion && !isAnimating) animate();
    }

    function selectedCategory() {
      return skillPanel.querySelector('[data-skill-category].active')?.getAttribute('data-skill-category') || 'todos';
    }

    function selectedGroup() {
      return skillPanel.querySelector('[data-skill-group].active')?.getAttribute('data-skill-group') || 'todos';
    }

    function updateGroups() {
      const category = selectedCategory();

      groupButtons.forEach((button) => {
        const parent = button.getAttribute('data-parent-category');
        const isAll = button.getAttribute('data-skill-group') === 'todos';
        button.hidden = !isAll && (category === 'todos' || parent !== category);
      });

      groupButtons.forEach((button) => button.classList.remove('active'));
      skillPanel.querySelector('[data-skill-group="todos"]')?.classList.add('active');
    }

    function applySkillFilters() {
      const category = selectedCategory();
      const group = selectedGroup();

      skills.forEach((skill, index) => {
        const matchesCategory = category === 'todos' || skill.getAttribute('data-category') === category;
        const matchesGroup = group === 'todos' || skill.getAttribute('data-group') === group;
        const isVisible = matchesCategory && matchesGroup;

        nodes[index].visible = isVisible;
        skill.hidden = false;
        skill.toggleAttribute('aria-hidden', !isVisible);
      });

      layoutNodes();
      projectNodes();
    }

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        categoryButtons.forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        updateGroups();
        applySkillFilters();
      });
    });

    groupButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (button.hidden) return;
        groupButtons.forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        applySkillFilters();
      });
    });

    updateGroups();
    applySkillFilters();

    const observer = new IntersectionObserver(([entry]) => {
      active = entry.isIntersecting;
      if (active && !reduceMotion && !isAnimating) animate();
      if (!active) {
        cancelAnimationFrame(animationId);
        isAnimating = false;
      }
    });

    cloud.addEventListener('pointerdown', (event) => {
      dragging = true;
      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
      cloud.setPointerCapture(event.pointerId);
    });

    cloud.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const deltaX = event.clientX - lastPointerX;
      const deltaY = event.clientY - lastPointerY;

      targetRotationY += deltaX * 0.008;
      targetRotationX = THREE.MathUtils.clamp(targetRotationX + deltaY * 0.008, -1.1, 1.1);
      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
    }, { passive: true });

    cloud.addEventListener('pointerup', (event) => {
      dragging = false;
      cloud.releasePointerCapture(event.pointerId);
    });

    cloud.addEventListener('pointerleave', () => {
      dragging = false;
    });

    window.addEventListener('resize', () => {
      layoutNodes();
      projectNodes();
    });
    observer.observe(cloud);
    setCloudMode();
  }
</script>
