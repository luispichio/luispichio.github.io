---
const { project } = Astro.props;

const categoryLabels = {
  featured: 'Destacados',
  small_things: 'Herramientas',
  tools: 'Herramientas',
  old: 'Históricos',
  industrial: 'Industrial',
  general: 'General',
};

const category = project.data.category ?? 'general';
const categoryLabel = categoryLabels[category] ?? category;
---

<article class="project-card filter-item" data-category={category} data-tags={project.data.tags.join(' ')}>
  {project.data.cover && <img src={project.data.cover} alt="" loading="lazy" />}
  <div>
    <p class="eyebrow">{project.data.company} {project.data.date ? `| ${project.data.date}` : ''}</p>
    <span class="category-badge">{categoryLabel}</span>
    <h3><a href={`/projects/${project.id.replace(/\.md$/, '')}/`}>{project.data.title}</a></h3>
    <p>{project.data.description}</p>
    {project.data.featured && <strong class="featured-mark">Destacado</strong>}
    <div class="tags">
      {project.data.tags.map((tag) => <span>{tag}</span>)}
    </div>
  </div>
</article>
