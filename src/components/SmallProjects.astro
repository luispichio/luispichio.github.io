---
import { smallProjects } from '../data/small-projects';

const visibleClients = (clients?: string[]) => clients?.filter(Boolean) ?? [];
---

<section class="small-projects-section" aria-labelledby="small-projects-title">
  <div class="section-title">
    <div>
      <p class="eyebrow">También</p>
      <h2 id="small-projects-title">Proyectos pequeños</h2>
    </div>
  </div>

  <div class="small-project-grid">
    {smallProjects.map((project) => {
      const clients = visibleClients(project.clients);

      return (
        <article class="small-project-card">
          <p class="eyebrow">{project.company}{project.date ? ` | ${project.date}` : ''}</p>
          <h3>
            {project.url ? <a href={project.url}>{project.title}</a> : project.title}
          </h3>
          <p>{project.description}</p>
          {clients.length > 0 && <p class="small-project-meta">Clientes: {clients.join(', ')}</p>}
          <div class="tags compact-tags">
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      );
    })}
  </div>
</section>
